 <!-- views/index.ejs -->

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Members Only</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="navbar">
    <a class="brand" href="/">Members Only</a>

    <nav class="nav-links">
      <% if (user) { %>
        <span>Welcome, <%= user.first_name %>!</span>
        <form action="/log-out" method="POST">
          <button class="button button-outline" type="submit">
            Log Out
          </button>
        </form>
      <% } else { %>
        <a href="/log-in">Log In</a>
        <a class="button" href="/sign-up">Sign Up</a>
      <% } %>
    </nav>
  </header>

  <main>
    <section class="hero">
      <p class="eyebrow">YOUR COMMUNITY</p>
      <h1>Welcome to Members Only.</h1>
      <p class="hero-description">
        A place to share your thoughts with the community.
      </p>

      <% if (user) { %>
        <a class="button button-light" href="/new-message">
          + Create a new message
        </a>
      <% } else { %>
        <a class="button button-light" href="/sign-up">
          Join the community
        </a>
      <% } %>
    </section>

    <section class="messages-section">
      <div class="section-heading">
        <div>
          <h2>Latest messages</h2>
          <p>See what the community is talking about.</p>
        </div>
        <span class="message-count">
          <%= messages.length %>
          <%= messages.length === 1 ? "post" : "posts" %>
        </span>
      </div>

      <% if (messages.length === 0) { %>
        <div class="empty-state">
          <h3>No messages yet</h3>
          <p>Be the first to share something with the community.</p>
        </div>
      <% } else { %>
        <% messages.forEach((message) => { %>
          <article class="message-card">
            <div class="message-header">
              <div class="avatar">
                <%= message.first_name ? message.first_name.charAt(0).toUpperCase() : "U" %>
              </div>

              <div class="message-meta">
                <h3><%= message.title %></h3>

                <% if (user && (user.membership_status || user.is_admin)) { %>
                  <p class="author">
                    <%= message.first_name %> <%= message.last_name %>
                    <span>·</span>
                    <%= new Date(message.timestamp).toLocaleDateString() %>
                  </p>
                <% } else { %>
                  <p class="author">Community member</p>
                <% } %>
              </div>
            </div>

            <p class="message-text"><%= message.text %></p>

            <% if (user && user.is_admin) { %>
              <div class="message-footer">
                <span class="post-label">Community post</span>

                <form action="/messages/<%= message.id %>/delete" method="POST">
                  <button class="button button-danger" type="submit">
                    Delete
                  </button>
                </form>
              </div>
            <% } %>
          </article>
        <% }) %>
      <% } %>
    </section>
  </main>
</body>
</html>
